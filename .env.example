# Copy values into your shell or an untracked .env file.
# MiniClaw does not load this file automatically.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional non-secret overrides:
MINICLAW_DATA_DIR=~/.miniclaw
MINICLAW_WORKSPACE=.
MINICLAW_REQUIRE_STRONG_SANDBOX=false
MINICLAW_DOCKER_IMAGE=python:3.12-slim
